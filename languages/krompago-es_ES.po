#. Plugin Name of the plugin
#: krompago.php
msgid "Krompago - Checkout Fees for WooCommerce"
msgstr ""

#. Plugin URI of the plugin
#: krompago.php
msgid "https://plogins.com/plogins-surcharge/"
msgstr ""

#. Description of the plugin
#: krompago.php
msgid "Add fixed or percentage fees to the WooCommerce cart and checkout."
msgstr ""
"Añade tarifas fijas o porcentuales al carrito y al pago (checkout) de "
"WooCommerce."

#. Author of the plugin
#: krompago.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
#: krompago.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

#: krompago.php:48
msgid "Krompago requires WooCommerce to be active."
msgstr ""

